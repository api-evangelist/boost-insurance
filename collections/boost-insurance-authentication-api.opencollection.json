{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boost Insurance Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.insurtech.dev/auth/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request an OAuth 2.0 access token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.insurtech.dev/auth/oauth2/token"
          },
          "docs": "Exchange a Client ID and Client Secret for a bearer access token using the OAuth 2.0 Client Credentials grant. The returned token must be sent as a Bearer token on subsequent API requests."
        }
      ]
    }
  ],
  "bundled": true
}